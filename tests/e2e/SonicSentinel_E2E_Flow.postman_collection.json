          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Review detail page renders successfully', function () {",
                  "    if (pm.collectionVariables.get('audio_id')) {",
                  "        pm.expect(pm.response.code).to.equal(200);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "05.4 - Submit Manual Review Decision",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "decision",
                  "value": "Panic Scream",
                  "type": "text"
                },
                {
                  "key": "comment",
                  "value": "Postman E2E automated test: Human verification confirmed panic scream distress signal.",
                  "type": "text"
                },
                {
                  "key": "recommended_action",
