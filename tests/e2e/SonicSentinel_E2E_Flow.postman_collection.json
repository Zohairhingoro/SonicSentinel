            "url": {
              "raw": "{{django_base_url}}/reviews/{{audio_id}}/",
              "host": ["{{django_base_url}}"],
              "path": ["reviews", "{{audio_id}}", ""]
            },
            "description": "Submits review decision: updates category, sets status to 'Reviewed', logs audit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Review decision accepted and saved', function () {",
                  "    if (pm.collectionVariables.get('audio_id')) {",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 302]);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
